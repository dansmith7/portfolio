# Supabase (для хостинга и локальной работы с облаком)
# Скопируй в .env и подставь свои значения из supabase.com → Settings → API
VITE_SUPABASE_URL=https://твой-проект.supabase.co
VITE_SUPABASE_ANON_KEY=твой-anon-public-ключ

# Локальный сервер (когда Supabase не используется)
ADMIN_PASSWORD=пароль_для_админки
